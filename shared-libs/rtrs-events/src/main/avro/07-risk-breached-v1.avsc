{
  "namespace": "com.rtrs.events.risk",
  "type": "record",
  "name": "RiskBreachedEvent",
  "doc": "Published when a trade breaches one or more risk limits",
  "fields": [
    {"name": "metadata", "type": "com.rtrs.events.common.EventMetadata"},
    {"name": "tradeId", "type": "string"},
    {"name": "accountId", "type": "string"},
    {"name": "instrumentId", "type": "string"},
    {
      "name": "breachType",
      "type": {
        "type": "enum",
        "name": "BreachType",
        "symbols": ["POSITION_LIMIT", "VAR_LIMIT", "MARGIN_BREACH", "CONCENTRATION_LIMIT", "INTRADAY_EXPOSURE"]
      }
    },
    {"name": "breachValue", "type": "double", "doc": "Actual value that caused the breach"},
    {"name": "thresholdValue", "type": "double", "doc": "Configured limit that was breached"},
    {"name": "riskScore", "type": "int", "doc": "AML risk score 0-100, threshold is 70"},
    {"name": "reason", "type": ["null", "string"], "default": null},
    {"name": "breachedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
